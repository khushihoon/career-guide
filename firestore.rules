rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// AI Career App — Firestore Security Rules
// PHASE 3 / STAGE 1 — SERVER-AUTHORITATIVE TARGET STATE
//
// !!  DEPLOYMENT GATE  !!
// These rules DENY every client write that awards XP or a reward
// (users.totalXp / totalGoalsCompleted, the XP ledgers, rewards, quests,
// achievements, leaderboard). The CURRENT Flutter client still performs
// those writes itself, so deploying this file BEFORE the trusted XP
// gateway and the matching Flutter changes ship will stop every user from
// earning XP. Keep the Phase 1 rules deployed until Stage 2 is live.
//
// WHAT CHANGED vs Phase 1
//   users/{uid}
//     * totalXp, totalGoalsCompleted, xpPoints: client can no longer change
//       them (Phase 1 allowed unlimited +3000 / +1 writes).
//     * create: server-owned counters must be absent or 0 (Phase 1 allowed
//       a new account to start with up to 3000 XP).
//     * known profile fields are type/size validated when they change.
//     * every other field stays client-writable on purpose (see "field
//       inventory" below) so no legitimate flow breaks.
//   XP ledgers (copilot_goal_events, copilot_job_offer_events,
//   copilot_learning_progress/*/events, rewards/*/history)
//     * XP-bearing rows (quiz, challenge, goal, course project, rewards
//       history): client create/update/delete denied (server-written).
//     * ZERO-XP evidence rows (lesson:, project:, jobApplication:,
//       interview:, jobOffer:) may still be CREATED by the client because the
//       existing appendCompleted*/appendAppliedJob/recordJobOffer writers do
//       so; they can never be updated or deleted. (Revision 2 fix: revision 1
//       denied these and would have broken those flows.)
//   copilot_learning_progress/{careerId}  (aggregate)
//     * careerTotalXp, completedCourseEventIds, courseEvidenceIds are
//       server-owned. Lesson progress fields stay client-writable.
//   copilot_daily_goals
//     * isCompleted can no longer be set/flipped by the client; xpReward
//       stays capped as defence in depth (the server ignores it).
//   rewards/{uid}, quests/{uid}, achievements/{uid}
//     * read-only for the owner; all writes server-only.
//   leaderboard/{board}/entries/{uid}
//     * read: any signed-in user. create/update: server only.
//       delete: owner (privacy), harmless because the server re-syncs.
//   analytics/{uid}
//     * NEW: owner read, no client writes. Fixes the Phase 1 regression in
//       which AnalyticsScreen's read of its own doc was default-denied.
//
// FIELD INVENTORY — users/{uid} fields written by the client (seen in the
// audited source): name, city, phone, bio, targetRole, experience, skills,
// updatedAt (ProfileScreen) and signup fields (name, xpPoints:0, createdAt).
// Fields written elsewhere but NOT yet confirmed (appliedJobs,
// completedSteps, dailyStreak, location, email, lastActiveAt, ...) are left
// client-writable until a repo-wide grep confirms their writers. Only the
// three XP fields are blocked.
//
// WHAT RULES CANNOT DO
//   Rules alone cannot verify that a learner really completed an activity.
//   That decision belongs to the trusted backend (Stage 2). These rules make
//   sure the client cannot bypass it.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Keys whose value changes in this update (unchanged keys are excluded).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Server-owned key sets ─────────────────────────────────────────
    function userServerKeys() {
      return ['totalXp', 'totalGoalsCompleted', 'xpPoints'];
    }
    function lpServerKeys() {
      return ['careerTotalXp', 'completedCourseEventIds', 'courseEvidenceIds'];
    }

    // ── users: profile validation ─────────────────────────────────────
    // `changed` is the set of keys being created/modified. Only those keys
    // are validated, so legacy documents with odd values in untouched
    // fields never block an unrelated update.
    function profileFieldsOk(d, changed) {
      return (!('name' in changed) ||
              (d.get('name', '') is string && d.get('name', '').size() <= 100))
          && (!('city' in changed) ||
              (d.get('city', '') is string && d.get('city', '').size() <= 120))
          && (!('location' in changed) ||
              (d.get('location', '') is string && d.get('location', '').size() <= 120))
          && (!('phone' in changed) ||
              (d.get('phone', '') is string && d.get('phone', '').size() <= 40))
          && (!('bio' in changed) ||
              (d.get('bio', '') is string && d.get('bio', '').size() <= 1000))
          && (!('targetRole' in changed) ||
              (d.get('targetRole', '') is string && d.get('targetRole', '').size() <= 80))
          && (!('experience' in changed) ||
              (d.get('experience', '') is string && d.get('experience', '').size() <= 40))
          && (!('skills' in changed) ||
              (d.get('skills', []) is list && d.get('skills', []).size() <= 200));
    }

    function userCreateOk() {
      let d = request.resource.data;
      return d.get('totalXp', 0) == 0
          && d.get('totalGoalsCompleted', 0) == 0
          && d.get('xpPoints', 0) == 0
          && profileFieldsOk(d, d.keys());
    }

    function userUpdateOk() {
      return !changedKeys().hasAny(userServerKeys())
          && profileFieldsOk(request.resource.data, changedKeys());
    }

    // ── zero-XP evidence events ───────────────────────────────────────
    // Lesson / project / application / interview / job-offer EVIDENCE rows are
    // still written by the client (appendCompletedLesson, appendCompletedProject,
    // appendAppliedJob, appendCompletedInterview, recordJobOffer). They carry
    // NO XP. Anything with xp > 0 (quiz, challenge, goal, course project) is
    // written only by the trusted backend. The id prefix and eventType must
    // agree so a zero-XP row cannot squat on an XP-bearing id (quiz:, goal:, ...).
    // Project XP events created by the trusted gateway use the exact ID
    // `project:<courseId>`, where courseId follows the gateway's canonical
    // `<careerId>_level<N>` or `<careerId>_level<N>_lesson<N>` format.
    // Client zero-XP project evidence must not be allowed to pre-create those
    // reserved IDs, otherwise it could block the trusted XP transaction.
    function isReservedProjectXpEventId(eventId) {
      return eventId.matches(
        '^project:.*_level[0-9]{1,3}(_lesson[0-9]{1,3})?$'
      );
    }

    // Enforce an exact eventType-to-prefix mapping. This prevents a client
    // from labelling one kind of evidence as another. All client-created
    // evidence is zero-XP and create-only; trusted XP event IDs are reserved.
    function zeroXpEventOk(eventId) {
      let d = request.resource.data;
      let eventType = d.get('eventType', '');
      return d.get('xp', 0) == 0
          && (
            (eventType == 'lesson'
              && eventId.matches('^lesson:.+$'))
            || (eventType == 'project'
              && eventId.matches('^project:.+$')
              && !isReservedProjectXpEventId(eventId))
            || (eventType == 'jobApplication'
              && eventId.matches('^jobApplication:.+$'))
            || (eventType == 'interview'
              && eventId.matches('^interview:.+$'))
            || (eventType == 'jobOffer'
              && eventId.matches('^jobOffer:.+$'))
          );
    }

    // ── daily goals ───────────────────────────────────────────────────
    function goalXpOk(d) {
      let x = d.get('xpReward', 0);
      return x is number && x >= 0 && x <= 500;
    }

    // ── applications ──────────────────────────────────────────────────
    function coverLetterOk(d) {
      let c = d.get('coverLetter', '');
      return c is string && c.size() <= 10000;
    }

    // ══════════════════════════════════════════════════════════════════
    // USERS  users/{uid}
    // ══════════════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && userCreateOk();
      allow update: if isOwner(uid) && userUpdateOk();
      allow delete: if false;      // account deletion runs on the server

      // ── XP ledgers: server-written, owner-readable ─────────────────
      match /copilot_goal_events/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /copilot_job_offer_events/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && zeroXpEventOk(eventId);
        allow update, delete: if false;
      }

      // Aggregate doc: lesson progress stays client-writable; the XP and
      // course-evidence mirrors are server-owned. The event ledger below
      // it is server-only.
      match /copilot_learning_progress/{careerId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && !request.resource.data.keys().hasAny(lpServerKeys());
        allow update: if isOwner(uid)
          && !changedKeys().hasAny(lpServerKeys());
        allow delete: if false;

        match /events/{eventId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && zeroXpEventOk(eventId);
          allow update, delete: if false;
        }
      }

      // Daily goals: the client authors the goal text, but completion
      // (isCompleted) is decided by the server.
      match /copilot_daily_goals/{goalId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && goalXpOk(request.resource.data)
          && request.resource.data.get('isCompleted', false) == false;
        allow update: if isOwner(uid)
          && goalXpOk(request.resource.data)
          && !changedKeys().hasAny(['isCompleted']);
      }

      // All other user subcollections (copilot/, copilot_progress/,
      // copilot_skill_gaps/, copilot_next_actions/, copilot_recommendations/,
      // copilot_skill_gap_history/ and any not seen in the audited source)
      // keep the previous owner-only behaviour. The protected
      // subcollections above are excluded so OR-ing of rules can never
      // re-open them. NOTE: data here is non-authoritative; the server must
      // never derive XP, streaks or rewards from it.
      match /{sub}/{docPath=**} {
        allow read, write: if isOwner(uid)
          && !(sub in [
            'copilot_goal_events',
            'copilot_job_offer_events',
            'copilot_learning_progress',
            'copilot_daily_goals'
          ]);
      }
    }

    // ══════════════════════════════════════════════════════════════════
    // REWARDS  rewards/{uid}  (+ history) — server-only writes
    // ══════════════════════════════════════════════════════════════════
    match /rewards/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /history/{historyId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════
    // QUESTS  quests/{uid} — server-only writes
    // ══════════════════════════════════════════════════════════════════
    match /quests/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // ACHIEVEMENTS  achievements/{uid} — server-only writes
    // ══════════════════════════════════════════════════════════════════
    match /achievements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // ANALYTICS  analytics/{uid} — derived cache, server-only writes
    // ══════════════════════════════════════════════════════════════════
    match /analytics/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // AI MEMORY  ai_memory/{uid}  (non-authoritative summary; unchanged)
    // ══════════════════════════════════════════════════════════════════
    match /ai_memory/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ══════════════════════════════════════════════════════════════════
    // LEADERBOARD  leaderboard/{board}/entries/{uid}
    //   board = 'global' | 'weekly_YYYY_M_D'
    //   Entries are written by the trusted server from authoritative XP.
    // ══════════════════════════════════════════════════════════════════
    match /leaderboard/{board}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if isOwner(uid);
    }

    // ══════════════════════════════════════════════════════════════════
    // SAVED JOBS  saved_jobs/{uid_jobId}   (unchanged from Phase 1)
    //   A get() of a NON-EXISTENT doc has resource == null; the 'uid_'
    //   prefix check makes the existence probe safe.
    // ══════════════════════════════════════════════════════════════════
    match /saved_jobs/{savedJobId} {
      allow get: if signedIn() && (
        (resource == null && savedJobId.matches('^' + request.auth.uid + '_.*'))
        || (resource != null && resource.data.userId == request.auth.uid));
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════════════════
    // APPLICATIONS  applications/{uid_jobId}   (contains PII)
    //   Phase 3: the cover-letter size limit now also applies to updates.
    // ══════════════════════════════════════════════════════════════════
    match /applications/{applicationId} {
      allow get: if signedIn() && (
        (resource == null && applicationId.matches('^' + request.auth.uid + '_.*'))
        || (resource != null && resource.data.userId == request.auth.uid));
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && coverLetterOk(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && coverLetterOk(request.resource.data);
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ══════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}